// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Campaign {
  id                 String    @id @default(cuid())
  shop               String
  name               String
  type               String    // quantity_discount, bulk_price, cart_goal, buy_x_get_y, shipping_discount
  status             String    @default("draft") // draft, active, scheduled, expired, paused
  discountType       String    // percentage, fixed_amount, free_shipping
  discountValue      Float?
  startDate          DateTime?
  endDate            DateTime?
  priority           Int       @default(0)
  stackable          Boolean   @default(false)
  appliesTo          String    @default("all") // all, specific_products, specific_collections
  productIds         String?   // JSON array of product IDs
  collectionIds      String?   // JSON array of collection IDs
  excludeProductIds  String?   // JSON array of excluded product IDs
  minimumQuantity    Int?
  maximumQuantity    Int?
  minimumAmount      Float?    // Minimum order value (for shipping_discount, cart_goal, etc.)
  requirementType    String    @default("amount") // amount, quantity, both, either — which minimum(s) apply
  geoTarget          String?   // "domestic" | "all" — for shipping_discount campaigns

  // Which other discount types this campaign may stack with
  combineWithProducts Boolean  @default(true)
  combineWithOrders   Boolean  @default(true)
  combineWithShipping Boolean  @default(true)

  shopifyDiscountId  String?   // Discount node id returned by Shopify (so we can delete/update later)
  tiers              String?   // JSON array of tier objects { qty, discount }
  discountedVariants Int       @default(0)

  // Advanced discount code — email-capture popup
  discountCode       String?   // persisted so the popup email can send it to shoppers
  popupEnabled       Boolean   @default(false)
  popupPages         String?   // JSON array e.g. ["all"] or ["index","product","cart"]
  popupHeading       String?
  popupDescription   String?
  popupButtonText    String?
  popupDelaySeconds  Int?      // wait this long before first showing the popup; null = use the theme app-embed default
  popupFrequencyValue Int?     // how long to wait before re-showing after a shopper closes it
  popupFrequencyUnit  String?  // "minutes" | "hours"
  // Content of the discount-code email (separate from the on-site popup text).
  // JSON { heading, body, buttonText, buttonUrl, footer }. On MySQL: @db.Text.
  emailContent       String?   @db.VarChar(10000)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([shop])
  @@index([shop, status])
}

model PopupSubmission {
  id         String   @id @default(cuid())
  shop       String
  campaignId String
  email      String
  code       String?
  createdAt  DateTime @default(now())

  @@index([shop])
  @@index([shop, campaignId])
}

model Setting {
  id                  String  @id @default(cuid())
  shop                String  @unique
  roundPrices         Boolean @default(true)
  roundingMethod      String  @default("nearest")
  showCompareAtPrice  Boolean @default(true)
  stackDiscounts      Boolean @default(false)
  displaySavings      Boolean @default(true)
  savingsFormat       String  @default("percentage")
  excludeSaleProducts Boolean @default(false)
  customCss           String  @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model WidgetCustomization {
  id          String @id @default(cuid())
  shop        String
  widgetType  String // countdown_start, countdown_end, quantity_table, bxgy_popup, shipping_bar, saving_cart, bxgy_fab
  config      String // JSON configuration
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, widgetType])
  @@index([shop])
}

model Subscription {
  id                  String    @id @default(cuid())
  shop                String    @unique
  planId              String
  status              String    @default("pending")
  shopifyChargeId     String?
  confirmationUrl     String?
  currentPeriodEnd    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([shop])
}

model CampaignAnalytics {
  id                  String   @id @default(cuid())
  shop                String

  // Snapshot of campaign data at time of recording (persists after deletion)
  campaignId          String   // original Campaign.id (may no longer exist)
  campaignName        String
  campaignType        String   // quantity_discount, bulk_price, cart_goal, buy_x_get_y, shipping_discount
  campaignStatus      String   // active, expired, paused, deleted
  discountType        String   // percentage, fixed_amount, free_shipping
  discountValue       Float?
  startDate           DateTime?
  endDate             DateTime?

  // Product/collection targeting snapshot
  appliesTo           String   @default("all")
  productIds          String?  // JSON array of {id, title, image} objects
  collectionIds       String?  // JSON array of {id, title} objects

  // Performance metrics
  totalOrders         Int      @default(0)
  totalRevenue        Float    @default(0)
  totalDiscountGiven  Float    @default(0)
  totalFreeShipping   Float    @default(0)  // total shipping value waived
  totalItemsDiscounted Int     @default(0)
  averageOrderValue   Float    @default(0)
  conversionRate      Float    @default(0)  // percentage

  // Tier breakdown (for quantity/bulk discount) — JSON array of {qty, discount, usageCount}
  tierBreakdown       String?

  // Buy X Get Y breakdown — JSON {buyQty, getQty, usageCount, freeItemsGiven}
  bxgyBreakdown       String?

  // Shipping discount breakdown — JSON {domestic, international, totalOrders}
  shippingBreakdown   String?

  // Top products by discount usage — JSON array of {productId, title, ordersCount, discountTotal}
  topProducts         String?

  // Shopify discount node id for reference
  shopifyDiscountId   String?

  isDeleted           Boolean  @default(false)  // soft delete for analytics records
  deletedAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([shop])
  @@index([shop, campaignId])
  @@index([shop, isDeleted])
}
