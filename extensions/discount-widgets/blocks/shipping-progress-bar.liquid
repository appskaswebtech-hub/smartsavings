{% comment %}
  SmartDiscounts - Shipping Progress Bar

  Selection rule (re-evaluated on every cart change):
    1. If cart contains ONLY specific-campaign products:
         → show specific threshold, progress = sum of matching items
    2. If cart contains ANY non-specific product (mixed OR only non-specific):
         → show max(specific_threshold, all_products_threshold), progress = cart total
    3. If only one campaign type is active, that one wins for its cart context.
    4. If no campaign applies → hide.

  Backend contract (from /apps/smartdiscounts):
    campaign.type === "shipping_discount"
    campaign.discountType === "free_shipping"
    campaign.status === "active"
    campaign.minimumAmount   (number, dollars)
    campaign.appliesTo       ("all" | "specific_products" | ...)
    campaign.productIds      (array of numeric product id strings)
{% endcomment %}

{{ 'discount-widgets.css' | asset_url | stylesheet_tag }}

{% if block.settings.enabled %}
  <div
    id="sd-shipping-{{ block.id }}"
    data-sd-widget="shipping_bar"
    data-shop="{{ shop.permanent_domain }}"
    data-current-product-id="{% if product %}{{ product.id }}{% endif %}"
    data-initial="{{ block.settings.initial_message }}"
    data-progress="{{ block.settings.progress_message }}"
    data-success="{{ block.settings.success_message }}"
    style="
      display: none;
      background: {{ block.settings.bg_color }};
      border: 1px solid {{ block.settings.border_color }};
      border-radius: {{ block.settings.card_radius }}px;
      padding: 12px 16px;
      font-size: {{ block.settings.text_size }}px;
      color: {{ block.settings.text_color }};
      margin: 16px 0;
    "
  >
    <div id="sd-shipping-msg-{{ block.id }}" style="font-weight:500;line-height:1.4;"></div>
    <div
      style="
        background: {{ block.settings.progress_bg }};
        border-radius: {{ block.settings.progress_radius }}px;
        height: 8px;
        margin-top: 8px;
        overflow: hidden;
      "
    >
      <div
        id="sd-shipping-fill-{{ block.id }}"
        style="
          background: {{ block.settings.progress_fg }};
          width: 0%;
          height: 100%;
          border-radius: {{ block.settings.progress_radius }}px;
          transition: width 0.5s ease;
        "
      ></div>
    </div>
  </div>

  <script src="{{ 'shipping-progress-bar.js' | asset_url }}" defer></script>
  <script src="{{ 'sd-widget-layout.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Shipping Progress Bar",
  "target": "section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable shipping progress bar", "default": true },
    {
      "type": "paragraph",
      "content": "Free shipping threshold is pulled from your active Free Shipping campaigns. In a cart with only specific-campaign products, the specific threshold is used. Otherwise the higher of (specific, all-products) is used."
    },
    { "type": "text", "id": "initial_message", "label": "Initial message", "default": "Add {amount} to unlock free shipping" },
    { "type": "text", "id": "progress_message", "label": "Progress message", "default": "You're {amount} away from free shipping!" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You've unlocked free shipping!" },
    { "type": "header", "content": "Card Style" },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 10, "max": 18, "step": 1, "default": 13, "unit": "px" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#E0E0E0" },
    { "type": "range", "id": "card_radius", "label": "Card border radius", "min": 0, "max": 20, "step": 1, "default": 8, "unit": "px" },
    { "type": "header", "content": "Progress Bar Style" },
    { "type": "color", "id": "progress_bg", "label": "Progress background", "default": "#E5E5E5" },
    { "type": "color", "id": "progress_fg", "label": "Progress fill color", "default": "#10B981" },
    { "type": "range", "id": "progress_radius", "label": "Progress border radius", "min": 0, "max": 10, "step": 1, "default": 4, "unit": "px" }
  ]
}
{% endschema %}
