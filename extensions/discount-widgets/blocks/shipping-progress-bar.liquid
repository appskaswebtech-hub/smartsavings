{% comment %}
  SmartDiscounts - Shipping Progress Bar
  Supports: amount, quantity, both (AND), either (OR)
{% endcomment %}

{{ 'discount-widgets.css' | asset_url | stylesheet_tag }}

{% if block.settings.enabled %}
<div
  id="sd-shipping-{{ block.id }}"
  data-shop="{{ shop.permanent_domain }}"
  data-sym="{{ cart.currency.symbol }}"
  style="
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: 14px 16px;
    margin: 16px 0;
    display: none;
  "
>
  <div id="sd-ship-msg-{{ block.id }}" style="font-size:14px;font-weight:600;margin-bottom:10px;text-align:center;"></div>
  <div style="background:#f0f0f0;border-radius:99px;height:6px;overflow:hidden;">
    <div id="sd-ship-bar-{{ block.id }}" style="height:6px;border-radius:99px;background:{{ block.settings.bar_color }};width:0%;transition:width 0.5s ease;"></div>
  </div>
  <div id="sd-ship-sub-{{ block.id }}" style="font-size:11px;color:#888;text-align:center;margin-top:6px;"></div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var B    = '{{ block.id }}';
  var box  = document.getElementById('sd-shipping-' + B);
  var msg  = document.getElementById('sd-ship-msg-' + B);
  var bar  = document.getElementById('sd-ship-bar-' + B);
  var sub  = document.getElementById('sd-ship-sub-' + B);
  if (!box) return;

  var S           = box.dataset.sym || '$';
  var barColor    = '{{ block.settings.bar_color }}';
  var successColor = '{{ block.settings.success_color }}';

  function fmt(dollars) {
    var s = parseFloat(dollars).toFixed(2).split('.');
    s[0] = s[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    return S + (s[1] === '00' ? s[0] : s.join('.'));
  }

  function getItemCount(cart) {
    return (cart.items || []).reduce(function(sum, item) { return sum + (item.quantity || 0); }, 0);
  }

  function render(campaign, cart) {
    var minAmount  = parseFloat(campaign.minimumAmount  || 0) || 0;
    var minQty     = parseInt(campaign.minimumQuantity   || 0) || 0;
    var reqType    = campaign.requirementType || 'amount';

    var cartDollars   = (cart.total_price || 0) / 100;
    var cartItemCount = getItemCount(cart);

    // ── Check which conditions are met ──────────────────────────────
    var amountMet = (minAmount <= 0) || (cartDollars >= minAmount);
    var qtyMet    = (minQty   <= 0) || (cartItemCount >= minQty);

    // ── Determine unlock based on requirement type ───────────────────
    var unlocked;
    if (reqType === 'amount') {
      unlocked = amountMet;
    } else if (reqType === 'quantity') {
      unlocked = qtyMet;
    } else if (reqType === 'either') {
      unlocked = amountMet || qtyMet;          // OR logic
    } else {
      unlocked = amountMet && qtyMet;          // "both" = AND logic (default)
    }

    // ── Calculate fill percentage ────────────────────────────────────
    var fillPct = 0;
    if (unlocked) {
      fillPct = 100;
    } else if (reqType === 'amount') {
      fillPct = minAmount > 0 ? Math.min(100, cartDollars / minAmount * 100) : 0;
    } else if (reqType === 'quantity') {
      fillPct = minQty > 0 ? Math.min(100, cartItemCount / minQty * 100) : 0;
    } else if (reqType === 'either') {
      // Show progress toward whichever condition is CLOSEST to being met
      var amtPct = minAmount > 0 ? Math.min(100, cartDollars / minAmount * 100) : (amountMet ? 100 : 0);
      var qtyPct = minQty   > 0 ? Math.min(100, cartItemCount / minQty * 100)   : (qtyMet   ? 100 : 0);
      fillPct = Math.max(amtPct, qtyPct);      // show best progress
    } else {
      // "both" — show LOWER (further from completion)
      var amtPct = minAmount > 0 ? Math.min(100, cartDollars / minAmount * 100) : 100;
      var qtyPct = minQty   > 0 ? Math.min(100, cartItemCount / minQty * 100)   : 100;
      fillPct = Math.min(amtPct, qtyPct);
    }

    // ── Build sub-line ───────────────────────────────────────────────
    var subParts = [];
    if (minAmount > 0) subParts.push(fmt(cartDollars) + ' / ' + fmt(minAmount));
    if (minQty > 0)    subParts.push(cartItemCount + ' / ' + minQty + ' items');
    var connector = (reqType === 'either') ? '  OR  ' : '  ·  ';
    var subText = subParts.join(connector);

    // ── Build message ────────────────────────────────────────────────
    var msgText = '';

    if (unlocked) {
      msgText = '🎉 You\'ve unlocked free shipping!';
      bar.style.background = successColor || '#10B981';
      bar.style.width = '100%';
      sub.style.display = 'none';

    } else if (reqType === 'amount') {
      var rem = fmt(minAmount - cartDollars);
      msgText = 'Add <strong>' + rem + '</strong> to unlock free shipping 🚚';

    } else if (reqType === 'quantity') {
      var remQty = minQty - cartItemCount;
      msgText = 'Add <strong>' + remQty + ' more ' + (remQty === 1 ? 'item' : 'items') + '</strong> to unlock free shipping 🚚';

    } else if (reqType === 'either') {
      // Show the most achievable condition (closest to being met)
      var amtPct2 = minAmount > 0 ? (cartDollars / minAmount * 100) : 0;
      var qtyPct2 = minQty   > 0 ? (cartItemCount / minQty   * 100) : 0;

      if (qtyPct2 >= amtPct2 && minQty > 0 && !qtyMet) {
        // Quantity is closer
        var remQty2 = minQty - cartItemCount;
        msgText = 'Add <strong>' + remQty2 + ' more ' + (remQty2 === 1 ? 'item' : 'items') + '</strong> OR <strong>' + fmt(Math.max(0, minAmount - cartDollars)) + '</strong> more to unlock free shipping 🚚';
      } else if (minAmount > 0 && !amountMet) {
        // Amount is closer
        msgText = 'Add <strong>' + fmt(Math.max(0, minAmount - cartDollars)) + '</strong> more OR <strong>' + Math.max(0, minQty - cartItemCount) + ' more items</strong> to unlock free shipping 🚚';
      } else {
        msgText = 'Add more to unlock free shipping 🚚';
      }

    } else {
      // "both" — show unmet conditions
      var parts = [];
      if (!amountMet && minAmount > 0) parts.push('<strong>' + fmt(minAmount - cartDollars) + '</strong> more');
      if (!qtyMet   && minQty   > 0)   parts.push('<strong>' + Math.max(0, minQty - cartItemCount) + ' more ' + (minQty - cartItemCount === 1 ? 'item' : 'items') + '</strong>');
      msgText = 'Add ' + parts.join(' and ') + ' to unlock free shipping 🚚';
    }

    msg.innerHTML = msgText;
    if (!unlocked) {
      bar.style.background = barColor;
      bar.style.width = fillPct + '%';
      sub.textContent = subText;
      sub.style.display = subText ? 'block' : 'none';
    }
    box.style.display = 'block';
  }

  var activeCampaign = null;

  function refresh() {
    if (!activeCampaign) return;
    fetch('/cart.js', { credentials: 'same-origin' })
      .then(function(r) { return r.json(); })
      .then(function(cart) { render(activeCampaign, cart); })
      .catch(function() {});
  }

  fetch('/apps/smartdiscounts?shop=' + encodeURIComponent(box.dataset.shop || ''))
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var campaigns = data.campaigns || [];
      for (var i = 0; i < campaigns.length; i++) {
        if (campaigns[i].type === 'shipping_discount' && campaigns[i].status === 'active') {
          activeCampaign = campaigns[i];
          break;
        }
      }
      if (!activeCampaign) return;

      // Initial render
      fetch('/cart.js', { credentials: 'same-origin' })
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          render(activeCampaign, cart);
          setInterval(refresh, 2000);

          var observer = new MutationObserver(function() { refresh(); });
          observer.observe(document.body, { childList: true, subtree: true });
        });
    })
    .catch(function() {});
});
</script>
{% endif %}

{% schema %}
{
  "name": "Shipping Progress Bar",
  "target": "section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable shipping progress bar", "default": true },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "🎉 You've unlocked free shipping!" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bar_color",     "label": "Progress bar color", "default": "#1a1a1a" },
    { "type": "color", "id": "success_color", "label": "Success bar color",  "default": "#10B981" },
    { "type": "color", "id": "border_color",  "label": "Border color",       "default": "#E0E0E0" },
    { "type": "range", "id": "border_radius", "label": "Border radius", "min": 0, "max": 20, "step": 1, "default": 8, "unit": "px" }
  ]
}
{% endschema %}
