{% comment %}
  SmartDiscounts - Cart Goal Widget
  Auto-fetches from app proxy. Hides if no active campaign matches.
{% endcomment %}

{{ 'discount-widgets.css' | asset_url | stylesheet_tag }}

{% if block.settings.enabled %}
  {% assign cart_total_cents = cart.total_price %}
  {% assign cart_total = cart_total_cents | divided_by: 100.0 %}

  <div
    id="sd-cartgoal-{{ block.id }}"
    data-cart-total="{{ cart_total }}"
    data-sym="{{ cart.currency.symbol }}"
    data-shop="{{ shop.permanent_domain }}"
    style="border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.border_radius }}px;overflow:hidden;margin:16px 0;display:none;"
  >
    <div style="background:{{ block.settings.header_bg }};color:{{ block.settings.text_color }};padding:12px 16px;font-weight:700;font-size:14px;display:flex;align-items:center;gap:8px;">
      <span style="font-size:18px;">🎯</span>
      {{ block.settings.header_title }}
    </div>
    <div id="sd-goal-tiers-{{ block.id }}"></div>
    <div id="sd-goal-progress-{{ block.id }}"></div>
    <div id="sd-goal-savings-{{ block.id }}"></div>
  </div>

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    var B = '{{ block.id }}';
    var box = document.getElementById('sd-cartgoal-' + B);
    if (!box) return;
    var cartTotal = parseFloat(box.dataset.cartTotal) || 0;
    var S = box.dataset.sym || '$';
    var tiersEl = document.getElementById('sd-goal-tiers-' + B);
    var progressEl = document.getElementById('sd-goal-progress-' + B);
    var savingsEl = document.getElementById('sd-goal-savings-' + B);
    var activeColor = '{{ block.settings.active_color }}';
    var badgeColor = '{{ block.settings.badge_color }}';
    var textColor = '{{ block.settings.table_text_color }}';
    var progressBg = '{{ block.settings.progress_bg }}';
    var progressRadius = '{{ block.settings.progress_radius }}';

    function showWidget() { box.style.display = 'block'; }
    function hideWidget() { box.style.display = 'none'; }

    function render(tiers) {
      tiers.sort(function(a,b){ return a.amount - b.amount; });
      // "SAVE 10%" vs "SAVE $10", depending on the tier's discount type.
      function tierAmt(t) { return t.discountType === 'fixed_amount' ? S + t.discount : t.discount + '%'; }
      var html = '';
      var activeTier = null, nextTier = null, foundNext = false;
      tiers.forEach(function(t) {
        var reached = cartTotal >= t.amount;
        if (reached) activeTier = t;
        else if (!foundNext) { nextTier = t; foundNext = true; }
        html += '<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 16px;font-size:13px;border-top:1px solid rgba(0,0,0,0.06);transition:all 0.2s;'+(reached?'background:rgba(16,185,129,0.08);border-left:3px solid '+activeColor+';':'')+'"><span style="color:'+textColor+';'+(reached?'font-weight:700;':'')+'">Spend '+S+t.amount+'+</span><span style="background:'+(reached?activeColor:badgeColor)+';color:white;padding:3px 10px;border-radius:4px;font-size:11px;font-weight:700;">'+(reached?'✓ ':'')+'SAVE '+tierAmt(t)+'</span></div>';
      });
      tiersEl.innerHTML = html;

      var pHtml = '<div style="padding:12px 16px;border-top:1px solid rgba(0,0,0,0.06);background:#fafafa;">';
      if (nextTier) {
        var remaining = (nextTier.amount - cartTotal).toFixed(2);
        var progress = Math.min(100, (cartTotal / nextTier.amount) * 100);
        pHtml += '<div style="font-size:13px;color:'+textColor+';margin-bottom:8px;font-weight:600;">'+(activeTier ? '✅ Saving '+tierAmt(activeTier)+' — add '+S+remaining+' more for '+tierAmt(nextTier)+' off!' : 'Add '+S+remaining+' more to unlock '+tierAmt(nextTier)+' off!')+'</div>';
        pHtml += '<div style="background:'+progressBg+';border-radius:'+progressRadius+'px;height:8px;overflow:hidden;"><div style="background:'+activeColor+';width:'+progress+'%;height:100%;border-radius:'+progressRadius+'px;transition:width 0.5s;"></div></div>';
      } else if (activeTier) {
        pHtml += '<div style="font-size:13px;color:'+activeColor+';font-weight:700;text-align:center;">🎉 Maximum discount unlocked — saving '+tierAmt(activeTier)+'!</div>';
      }
      pHtml += '</div>';
      progressEl.innerHTML = pHtml;

      if (activeTier) {
        var savingsRaw = activeTier.discountType === 'fixed_amount'
          ? activeTier.discount
          : cartTotal * activeTier.discount / 100;
        var savingsAmount = Math.min(savingsRaw, cartTotal).toFixed(2);
        savingsEl.innerHTML = '<div style="padding:10px 16px;border-top:2px solid '+activeColor+';background:rgba(16,185,129,0.04);display:flex;justify-content:space-between;align-items:center;font-size:14px;"><span style="font-weight:700;color:'+activeColor+';">Your savings</span><span style="font-weight:700;color:'+activeColor+';font-size:16px;">-'+S+savingsAmount+'</span></div>';
      } else { savingsEl.innerHTML = ''; }

      showWidget();
    }

    fetch('/apps/smartdiscounts?shop=' + encodeURIComponent(box.dataset.shop || ''))
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var campaigns = data.campaigns || [];
        var matched = null;
        for (var i = 0; i < campaigns.length; i++) {
          if (campaigns[i].type === 'cart_goal' && campaigns[i].status === 'active') { matched = campaigns[i]; break; }
        }
        if (matched && matched.tiers && matched.tiers.length > 0) {
          var tiers = matched.tiers.map(function(t) {
            return {
              amount: parseFloat(t.amount || t.spend || t.q),
              discount: parseFloat(t.discount || t.d),
              discountType: t.discountType === 'fixed_amount' ? 'fixed_amount' : 'percentage'
            };
          }).filter(function(t) { return t.amount > 0 && t.discount > 0; });
          if (tiers.length > 0) { render(tiers); return; }
        }
        hideWidget();
      })
      .catch(function() { hideWidget(); });
  });
  </script>
{% endif %}

{% schema %}
{
  "name": "Cart Goal Discounts",
  "target": "section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable cart goal widget", "default": true },
    { "type": "text", "id": "header_title", "label": "Header title", "default": "Spend more, Save more!" },
    { "type": "header", "content": "Styles" },
    { "type": "color", "id": "text_color", "label": "Header text color", "default": "#000000" },
    { "type": "color", "id": "header_bg", "label": "Header background", "default": "#F5F5F5" },
    { "type": "color", "id": "table_text_color", "label": "Table text color", "default": "#333333" },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#E0E0E0" },
    { "type": "color", "id": "badge_color", "label": "Badge color (inactive)", "default": "#6366F1" },
    { "type": "color", "id": "active_color", "label": "Active/reached color", "default": "#10B981" },
    { "type": "color", "id": "progress_bg", "label": "Progress background", "default": "#E5E5E5" },
    { "type": "range", "id": "border_radius", "label": "Border radius", "min": 0, "max": 20, "step": 1, "default": 8, "unit": "px" },
    { "type": "range", "id": "progress_radius", "label": "Progress bar radius", "min": 0, "max": 10, "step": 1, "default": 4, "unit": "px" }
  ]
}
{% endschema %}
